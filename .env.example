# Copy this file to .env and fill in your own keys. NEVER commit .env.
# These are read ONLY by the Electron main process (src/main/services/aiProviders)
# and are never exposed to the renderer/browser context.

# --- Model providers: set at least one -------------------------------------------------
# Anthropic (Claude)   https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Groq                 https://console.groq.com/keys   (also used for fast ghost-text when set)
GROQ_API_KEY=
# Google Gemini        https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Voice sidecar (voice/server.py) — optional -----------------------------------------
# Full path to the Python interpreter that has `pip install -r voice/requirements.txt`.
# Leave blank to use `py -3` (Windows) / `python3` (macOS, Linux).
# For GPU Parakeet + Kokoro use a venv with onnxruntime-gpu + a CUDA build of torch, e.g.
#   Windows:     C:\path\to\venv\Scripts\python.exe
#   macOS/Linux: /path/to/venv/bin/python
VOICE_PYTHON=

# Speech-to-text model id for onnx-asr, and where to run it: auto | cuda | cpu
PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3
PARAKEET_DEVICE=auto
