# Copy this file to .env and fill in your own keys. Never commit .env.
# These are read ONLY by the Electron main process (src/main/services/aiProviders)
# and are never exposed to the renderer/browser context.

ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Voice sidecar (voice/server.py). Leave blank to use `py -3` (Windows) / python3.
# For GPU Parakeet + Kokoro point this at a venv with onnxruntime-gpu + torch CUDA, e.g. the voiceAgent one:
# VOICE_PYTHON=D:\Downloads\voiceAgent\.venv\Scripts\python.exe
VOICE_PYTHON=
# Parakeet model id for onnx-asr, and where to run it: auto | cuda | cpu
PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3
PARAKEET_DEVICE=auto
